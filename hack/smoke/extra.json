{
  "aastro": {
    "params": "flows=[{ path: '/smoke', method: 'GET', aggregation: { strategy: 'array', best_effort: false }, upstreams: [{ name: 'admin', hosts: 'http://127.0.0.1:7806', path: '/health', method: 'GET', timeout: '3s' }] }]"
  },
  "baikal": {
    "dbEngine": "mysql"
  },
  "cobalt": {
    "compose": "+ k.env({ API_URL: 'http://cobalt:9000/' })"
  },
  "continuwuity": {
    "params": "serverName='matrix.example.com'"
  },
  "docassemble": {
    "rolloutTimeout": 900
  },
  "docmost": {
    "compose": "+ k.env({ APP_URL: 'http://docmost:3000' })"
  },
  "endurain": {
    "compose": "+ k.env({ ENDURAIN_HOST: 'http://endurain:8080' })"
  },
  "fider": {
    "compose": "+ k.env({ BASE_URL: 'http://fider:3000' })"
  },
  "gotosocial": {
    "compose": "+ k.env({ GTS_HOST: 'social.example.com' })"
  },
  "habitat": {
    "compose": "+ k.env({ DATABASE_URL: 'postgresql://habitat:Kurly-e2e-Passw0rd@habitat-db-rw:5432/habitat?serverVersion=17&sslmode=disable' })"
  },
  "hatsu": {
    "compose": "+ k.env({ HATSU_DOMAIN: 'hatsu.example.com', HATSU_PRIMARY_ACCOUNT: 'example.com' })"
  },
  "isso": {
    "params": "host='http://isso:8080'"
  },
  "leantime": {
    "dbEngine": "mysql"
  },
  "libredesk": {
    "compose": "+ k.env({ LIBREDESK_APP__ROOT_URL: 'http://libredesk:9000' })"
  },
  "loki/server": {
    "params": "storageSecret='loki-storage', storageClass='standard'"
  },
  "lychee": {
    "compose": "+ k.env({ APP_URL: 'http://lychee:80', APP_ENV: 'production', FRANKENPHP_NUM_THREADS: '2', FRANKENPHP_WORKER: '0' })"
  },
  "mastodon": {
    "rolloutTimeout": 900,
    "maxRestarts": 8
  },
  "matrix-alertmanager-receiver": {
    "params": "homeserverUrl='https://matrix.example.com', userId='@alerts:matrix.example.com'"
  },
  "matrix-conduit": {
    "compose": "+ k.env({ CONDUIT_SERVER_NAME: 'matrix.example.com' })"
  },
  "metrics-server/server": {
    "params": "kubeletInsecureTLS=true"
  },
  "netbox": {
    "rolloutTimeout": 900
  },
  "opencost/server": {
    "params": "prometheusEndpoint='http://prometheus:9090'"
  },
  "peertube": {
    "compose": "+ k.env({ PEERTUBE_WEBSERVER_HOSTNAME: 'peertube.example.com' })"
  },
  "piwigo": {
    "dbEngine": "mysql"
  },
  "prestashop": {
    "compose": "+ k.env({ PS_INSTALL_AUTO: '1', PS_DOMAIN: 'prestashop', PS_HANDLE_DYNAMIC_DOMAIN: '0', PS_ERASE_DB: '0' })",
    "dbEngine": "mysql"
  },
  "remark42": {
    "compose": "+ k.env({ REMARK_URL: 'http://remark42:8080' })"
  },
  "safebucket": {
    "compose": "+ k.env({ DATABASE__POSTGRES__SSLMODE: 'disable', STORAGE__S3__ENDPOINT: 'seaweedfs-headless:8333' })"
  },
  "seaweedfs": {
    "stageOrder": "master volume filer server"
  },
  "shlink": {
    "compose": "+ k.env({ SKIP_INITIAL_GEOLITE_DOWNLOAD: 'true' })"
  },
  "speedtest-tracker": {
    "compose": "+ k.env({ APP_URL: 'http://speedtest-tracker' })"
  },
  "synapse/server": {
    "params": "serverName='synapse.example.com'"
  },
  "tube-archivist": {
    "compose": "+ k.env({ TA_HOST: 'http://tube-archivist:8000' })"
  },
  "tuwunel": {
    "params": "serverName='matrix.example.com'"
  },
  "vikunja": {
    "compose": "+ k.env({ VIKUNJA_SERVICE_PUBLICURL: 'http://vikunja:3456' })"
  },
  "wekan": {
    "params": "rootUrl='http://wekan:8080'"
  },
  "wetty": {
    "params": "sshHost='example.internal'"
  },
  "wordpress": {
    "dbEngine": "mysql"
  },
  "your-spotify": {
    "compose": "+ k.env({ API_ENDPOINT: 'http://your-spotify:8080', CLIENT_ENDPOINT: 'http://your-spotify:3000' })"
  },
  "yourls": {
    "compose": "+ k.env({ YOURLS_SITE: 'http://yourls' })"
  }
}
