          d.arg('labels', d.T.object, default={}),
          d.arg('annotations', d.T.object, default={}),
        ]) + { kind: 'http', secretKeys: [{ key: 'MUMBLE_SUPERUSER_PASSWORD', generate: 'password', length: 32 }] },
      },
