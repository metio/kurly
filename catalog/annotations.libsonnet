          d.arg('dbHost', d.T.string, default='kutt-db-rw'),
          d.arg('dbPort', d.T.int, default=5432),
          d.arg('dbName', d.T.string, default='kutt'),
          d.arg('dbUser', d.T.string, default='kutt'),
          d.arg('redisHost', d.T.string, default='kutt-cache-headless'),
          d.arg('redisPort', d.T.int, default=6379),
          d.arg('secretName', d.T.string, default='kutt'),
          d.arg('env', d.T.object, default={}),
          d.arg('resources', d.T.object, default={ requests: { cpu: '100m', memory: '256Mi' }, limits: { memory: '512Mi' } }),
          d.arg('labels', d.T.object, default={}),
          d.arg('annotations', d.T.object, default={}),
        ]) + { kind: 'http', secretKeys: [{ key: 'DB_PASSWORD', generate: 'password', length: 32 }, { key: 'REDIS_PASSWORD', generate: 'password', length: 32 }, { key: 'JWT_SECRET', generate: 'hex', length: 64 }] },
      },
