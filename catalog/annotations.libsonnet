          d.arg('labels', d.T.object, default={}),
          d.arg('annotations', d.T.object, default={}),
        ]) + { kind: 'http', secretKeys: [{ key: 'DB_PASSWORD', generate: 'password', length: 32 }, { key: 'APP_KEY', generate: 'hex', length: 64 }] },
