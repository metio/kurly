          d.arg('annotations', d.T.object, default={}),
        ]) + { kind: 'http', secretKeys: [{ key: 'POSTGRES_PASSWORD', generate: 'password', length: 32 }, { key: 'POSTGRES_DB', generate: 'literal', value: 'kurly' }, { key: 'POSTGRES_USER', generate: 'literal', value: 'kurly' }] },
      },
